#!/usr/bin/env python3
"""IntelGhost: find scoped Intel-only Mach-O components before macOS 28."""
from __future__ import annotations

import argparse
import json
import os
import platform
import subprocess
import sys
from pathlib import Path
from typing import Iterable

VERSION = "0.2.0"
MACHO_MAGICS = {b"\xcf\xfa\xed\xfe", b"\xfe\xed\xfa\xcf", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"}
COMPONENT_SUFFIXES = {
    ".app": "app",
    ".bundle": "bundle",
    ".component": "audio_component",
    ".framework": "framework",
    ".kext": "kernel_extension",
    ".mdimporter": "spotlight_importer",
    ".plugin": "plugin",
    ".qlgenerator": "quicklook_generator",
    ".vst": "vst",
    ".vst3": "vst3",
}
DEFAULT_DIRS = [
    "~/Applications",
    "/Applications",
    "~/Library/Audio/Plug-Ins",
    "/Library/Audio/Plug-Ins",
    "~/Library/QuickLook",
    "/Library/QuickLook",
    "~/Library/Spotlight",
    "/Library/Spotlight",
    "~/Library/ColorPickers",
    "/Library/ColorPickers",
    "/Library/Printers",
    "~/Library/Internet Plug-Ins",
    "/Library/Internet Plug-Ins",
    "~/Library/LaunchAgents",
    "/Library/LaunchAgents",
    "/Library/LaunchDaemons",
    "/usr/local/Homebrew",
    "/opt/homebrew",
]
SKIP_DIRS = {".git", "node_modules", "__pycache__", "Caches", "DerivedData"}


def is_macho(path: Path) -> bool:
    try:
        with path.open("rb") as fh:
            return fh.read(4) in MACHO_MAGICS
    except (OSError, PermissionError):
        return False


def iter_files(roots: Iterable[Path], max_files: int) -> Iterable[Path]:
    seen = 0
    for root in roots:
        if not root.exists():
            continue
        if root.is_file():
            yield root
            continue
        for dirpath, dirnames, filenames in os.walk(root, topdown=True):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
            if Path(dirpath).name == "Contents":
                dirnames[:] = [d for d in dirnames if d != "Resources"]
            for name in filenames:
                seen += 1
                if seen > max_files:
                    return
                yield Path(dirpath) / name


def lipo_archs(path: Path) -> tuple[list[str], str | None]:
    try:
        out = subprocess.check_output(["lipo", "-archs", str(path)], text=True, stderr=subprocess.STDOUT, timeout=3)
        return out.strip().split(), None
    except FileNotFoundError:
        return [], "lipo not found"
    except subprocess.CalledProcessError as exc:
        return [], exc.output.strip() or "lipo failed"
    except subprocess.TimeoutExpired:
        return [], "lipo timed out"


def classify(archs: list[str]) -> str:
    has_intel = any(a in {"x86_64", "i386"} for a in archs)
    has_arm = any(a in {"arm64", "arm64e"} for a in archs)
    if has_intel and not has_arm:
        return "intel_only"
    if has_intel and has_arm:
        return "universal"
    if has_arm:
        return "apple_silicon_only"
    return "unknown"


def component_for(path: Path) -> dict[str, str]:
    for candidate in (path, *path.parents):
        suffix = candidate.suffix.lower()
        if suffix in COMPONENT_SUFFIXES:
            return {
                "name": candidate.name,
                "type": COMPONENT_SUFFIXES[suffix],
                "path": str(candidate),
            }
    return {"name": path.name, "type": "binary", "path": str(path)}


def rosetta_state() -> str:
    marker = Path("/Library/Apple/usr/share/rosetta/rosetta")
    if marker.exists():
        return "installed"
    try:
        subprocess.check_call(["arch", "-x86_64", "/usr/bin/true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
        return "installed"
    except Exception:
        return "not_detected"


def scan(paths: list[str], max_files: int) -> dict:
    roots = [Path(os.path.expanduser(p)).resolve() for p in paths]
    results = []
    skipped = 0
    scanned = 0
    for path in iter_files(roots, max_files):
        if not is_macho(path):
            continue
        scanned += 1
        archs, error = lipo_archs(path)
        if error:
            skipped += 1
            continue
        kind = classify(archs)
        if kind == "intel_only":
            component = component_for(path)
            results.append({
                "path": str(path),
                "archs": archs,
                "component": component["name"],
                "component_type": component["type"],
                "component_path": component["path"],
                "risk": "macOS_28_incompatible_unless_updated",
            })
    affected_components = len({item["component_path"] for item in results})
    return {
        "tool": "intelghost",
        "version": VERSION,
        "platform": platform.platform(),
        "rosetta": rosetta_state() if sys.platform == "darwin" else "not_applicable",
        "scanned_macho_files": scanned,
        "skipped_macho_files": skipped,
        "intel_only_count": len(results),
        "affected_component_count": affected_components,
        "findings": results,
        "note": "Read-only scoped scan; findings are clues, not proof that a component is loaded or still needed.",
    }


def print_text(report: dict, quiet: bool) -> None:
    if not quiet:
        print(f"IntelGhost v{VERSION} — read-only Intel-only component scan")
        print(f"Rosetta: {report['rosetta']}")
        print(f"Mach-O scanned: {report['scanned_macho_files']}  skipped: {report['skipped_macho_files']}")
    print(f"Intel-only findings: {report['intel_only_count']}")
    print(f"Affected components: {report['affected_component_count']}")
    for item in report["findings"]:
        print(
            f"- {item['component']} [{item['component_type']}] :: {item['path']} :: "
            f"{','.join(item['archs'])} :: update or remove via its owner before macOS 28"
        )
    if not quiet and not report["findings"]:
        print("No Intel-only Mach-O components found in the scoped paths.")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Read-only scanner for scoped Intel-only macOS components.")
    parser.add_argument("--path", action="append", dest="paths", help="Path to scan; repeatable. Defaults to common app/plugin locations.")
    parser.add_argument("--max-files", type=int, default=20000, help="Safety cap for visited files (default: 20000).")
    parser.add_argument("--json", action="store_true", help="Print machine-readable JSON.")
    parser.add_argument("--quiet", action="store_true", help="Only print count and findings in text mode.")
    parser.add_argument("--version", action="version", version=f"intelghost {VERSION}")
    args = parser.parse_args(argv)
    report = scan(args.paths or DEFAULT_DIRS, max(1, args.max_files))
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_text(report, args.quiet)
    return 2 if report["intel_only_count"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
